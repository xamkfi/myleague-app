		{
			"name": "Single Match Demo",
			"item": [
				{
					"name": "01 - Create Match",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"SeasonId\": \"{{season_id}}\",\n  \"HomeTeamId\": \"{{home_team_id}}\",\n  \"AwayTeamId\": \"{{away_team_id}}\",\n  \"ScheduledDateTime\": \"2025-10-08T19:00:00\",\n  \"Venue\": \"Test Arena\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/FloorballMatchEvent/match",
							"host": ["{{baseUrl}}"],
							"path": ["FloorballMatchEvent", "match"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"console.log('🎯 Creating match...');",
									"console.log('Response status:', pm.response.code);",
									"console.log('Response body:', pm.response.text());",
									"",
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    ",
									"    if (response.success && response.data) {",
									"        pm.collectionVariables.set('match_id', response.data.id);",
									"        console.log('✅ Match created successfully!');",
									"        console.log('   Match ID:', response.data.id);",
									"        console.log('   Status:', response.data.status);",
									"        console.log('   Home Team:', response.data.homeTeamName);",
									"        console.log('   Away Team:', response.data.awayTeamName);",
									"        console.log('   Venue:', response.data.venue);",
									"        console.log('   Scheduled:', response.data.scheduledDateTime);",
									"    } else {",
									"        console.log('❌ Match created but no data in response');",
									"    }",
									"} else {",
									"    console.log('❌ Failed to create match');",
									"    try {",
									"        const errorResponse = pm.response.json();",
									"        console.log('Error details:', JSON.stringify(errorResponse, null, 2));",
									"    } catch (e) {",
									"        console.log('Could not parse error response');",
									"    }",
									"}"
								]
							}
						}
					]
				},
