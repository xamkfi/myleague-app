	"item": [
		{
			"name": "1. Get All Teams (Fetch Team IDs)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Extract team IDs from response and set as collection variables",
							"if (pm.response.code === 200) {",
							"    const responseJson = pm.response.json();",
							"    if (responseJson.data && responseJson.data.length > 0) {",
							"        let teams = responseJson.data;",
							"        ",
							"        // Sort teams alphabetically by name for consistent ordering",
							"        teams.sort((a, b) => a.name.localeCompare(b.name));",
							"        ",
							"        // Set team IDs as variables (up to 45 teams)",
							"        for (let i = 0; i < Math.min(teams.length, 45); i++) {",
							"            const teamVarName = 'team' + (i + 1) + 'Id';",
							"            pm.collectionVariables.set(teamVarName, teams[i].id);",
							"            console.log('Team ' + (i + 1) + ' ID set to: ' + teams[i].id + ' (Name: ' + teams[i].name + ')');",
							"        }",
							"        ",
							"        console.log('Total teams found: ' + teams.length);",
							"        console.log('Teams sorted alphabetically for consistent manager assignment');",
							"    } else {",
							"        console.log('No teams found in response');",
							"    }",
							"} else {",
							"    console.log('Failed to fetch teams. Response code: ' + pm.response.code);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/FloorballTeam?page=1&pageSize=50",
					"host": ["{{baseUrl}}"],
					"path": ["FloorballTeam"],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "pageSize",
							"value": "50"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Get All Managers (Fetch Manager IDs)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Extract manager IDs from response and set as collection variables",
							"if (pm.response.code === 200) {",
							"    const responseJson = pm.response.json();",
							"    if (responseJson.data && responseJson.data.length > 0) {",
							"        let managers = responseJson.data;",
							"        ",
							"        // Sort managers by team number extracted from lastName",
							"        managers.sort((a, b) => {",
							"            const getTeamNumber = (lastName) => {",
							"                const match = lastName.match(/Team(\\d+)/);",
							"                return match ? parseInt(match[1]) : 999;",
							"            };",
							"            return getTeamNumber(a.lastName) - getTeamNumber(b.lastName);",
							"        });",
							"        ",
							"        // Set manager IDs as variables (up to 45 managers)",
							"        for (let i = 0; i < Math.min(managers.length, 45); i++) {",
							"            const managerVarName = 'manager' + (i + 1) + 'Id';",
							"            pm.collectionVariables.set(managerVarName, managers[i].id);",
							"            console.log('Manager ' + (i + 1) + ' ID set to: ' + managers[i].id + ' (Name: ' + managers[i].fullName + ')');",
							"        }",
							"        ",
							"        console.log('Total managers found: ' + managers.length);",
							"        console.log('Managers sorted by team number for consistent assignment');",
							"    } else {",
							"        console.log('No managers found in response');",
							"    }",
							"} else {",
							"    console.log('Failed to fetch managers. Response code: ' + pm.response.code);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/Persons/search?name=Manager",
					"host": ["{{baseUrl}}"],
					"path": ["Persons", "search"],
					"query": [
						{
							"key": "name",
							"value": "Manager"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Batch Assign All 45 Managers to Teams",
			"event": [
				{
					"listen": "pre-request",
					"script": {
						"exec": [
							"// Initialize batch assignment tracking",
							"pm.collectionVariables.set('batchAssignmentIndex', '1');",
							"pm.collectionVariables.set('batchAssignmentTotal', '45');",
							"pm.collectionVariables.set('batchSuccessCount', '0');",
							"pm.collectionVariables.set('batchFailureCount', '0');",
							"",
							"console.log('🚀 Starting batch assignment of 45 managers to teams');",
							"console.log('========================================================');"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Handle batch assignment with recursive pm.sendRequest calls",
							"const totalAssignments = 45;",
							"let successCount = 0;",
							"let failureCount = 0;",
							"let completedCount = 0;",
							"",
							"// Function to make assignment request",
							"function assignManagerToTeam(index) {",
							"    if (index > totalAssignments) {",
							"        console.log('\\n🎉 Batch assignment complete!');",
							"        console.log('   Total assignments: ' + totalAssignments);",
							"        console.log('   Successful: ' + successCount);",
							"        console.log('   Failed: ' + failureCount);",
							"        console.log('========================================================');",
							"        return;",
							"    }",
							"    ",
							"    const managerId = pm.collectionVariables.get('manager' + index + 'Id');",
							"    const teamId = pm.collectionVariables.get('team' + index + 'Id');",
							"    ",
							"    if (!managerId || !teamId) {",
							"        console.log('⚠️  Skipping assignment ' + index + ' - missing IDs');",
							"        console.log('   Manager ID: ' + (managerId || 'NOT FOUND'));",
							"        console.log('   Team ID: ' + (teamId || 'NOT FOUND'));",
							"        failureCount++;",
							"        assignManagerToTeam(index + 1);",
							"        return;",
							"    }",
							"    ",
							"    const assignmentRequest = {",
							"        url: pm.collectionVariables.get('baseUrl') + '/FloorballTeamManager',",
							"        method: 'POST',",
							"        header: {",
							"            'Content-Type': 'application/json'",
							"        },",
							"        body: {",
							"            mode: 'raw',",
							"            raw: JSON.stringify({",
							"                personId: managerId,",
							"                teamId: teamId,",
							"                isActive: true",
							"            })",
							"        }",
							"    };",
							"    ",
							"    pm.sendRequest(assignmentRequest, function (err, response) {",
							"        completedCount++;",
							"        ",
							"        if (err || response.code !== 201) {",
							"            console.log('❌ Assignment ' + index + ' failed');",
							"            console.log('   Manager ID: ' + managerId);",
							"            console.log('   Team ID: ' + teamId);",
							"            if (err) {",
							"                console.log('   Error: ' + err);",
							"            } else {",
							"                console.log('   Response code: ' + response.code);",
							"                console.log('   Response: ' + response.text());",
							"            }",
							"            failureCount++;",
							"        } else {",
							"            console.log('✅ Assignment ' + index + ' successful');",
							"            console.log('   Manager ' + index + ' → Team ' + index);",
							"            successCount++;",
							"        }",
							"        ",
							"        // Continue with next assignment",
							"        assignManagerToTeam(index + 1);",
							"    });",
							"}",
							"",
							"// Start the batch assignment process",
							"console.log('Starting batch assignment process...');",
							"assignManagerToTeam(1);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			},
			"response": []
		}
	]
} 