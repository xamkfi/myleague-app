		{
			"name": "8. Batch Create FloorballPlayers and Assign to Teams",
			"event": [
				{
					"listen": "pre-request",
					"script": {
						"exec": [
							"// Initialize batch process tracking",
							"pm.collectionVariables.set('currentTeam', '1');",
							"pm.collectionVariables.set('totalTeams', '45');",
							"pm.collectionVariables.set('totalPlayersPerTeam', '17');",
							"pm.collectionVariables.set('totalSuccessfulAssignments', '0');",
							"pm.collectionVariables.set('totalFailedAssignments', '0');",
							"",
							"console.log('🚀 Starting batch creation and assignment of all players to teams');",
							"console.log('📊 Total teams: 45 | Players per team: 17 | Total assignments: 765');",
							"console.log('========================================================');"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Handle batch player creation and assignment with recursive pm.sendRequest calls",
							"const totalTeams = 45;",
							"const playersPerTeam = 17; // 2 goalkeepers + 3 of each other position",
							"let totalSuccessful = 0;",
							"let totalFailed = 0;",
							"let completedTeams = 0;",
							"",
							"// Define position mappings",
							"const positions = [",
							"    { role: 'goalkeeper', position: 'Goalkeeper', count: 2 },",
							"    { role: 'leftwinger', position: 'LeftWinger', count: 3 },",
							"    { role: 'center', position: 'Center', count: 3 },",
							"    { role: 'rightwinger', position: 'RightWinger', count: 3 },",
							"    { role: 'leftdefender', position: 'LeftDefender', count: 3 },",
							"    { role: 'rightdefender', position: 'RightDefender', count: 3 }",
							"];",
							"",
							"// Function to process one team's players",
							"function processTeam(teamNum) {",
							"    if (teamNum > totalTeams) {",
							"        console.log('\\n🎉 Batch assignment complete!');",
							"        console.log('   Total teams processed: ' + totalTeams);",
							"        console.log('   Total assignments: ' + (totalSuccessful + totalFailed));",
							"        console.log('   Successful: ' + totalSuccessful);",
							"        console.log('   Failed: ' + totalFailed);",
							"        console.log('========================================================');",
							"        return;",
							"    }",
							"    ",
							"    console.log('\\n🏒 Processing Team ' + teamNum + ' (' + (completedTeams + 1) + '/' + totalTeams + ')');",
							"    const teamId = pm.collectionVariables.get('team' + teamNum + 'Id');",
							"    ",
							"    if (!teamId) {",
							"        console.log('❌ Team ' + teamNum + ' ID not found, skipping...');",
							"        totalFailed += playersPerTeam;",
							"        completedTeams++;",
							"        processTeam(teamNum + 1);",
							"        return;",
							"    }",
							"    ",
							"    let teamPlayersProcessed = 0;",
							"    let teamSuccessful = 0;",
							"    let teamFailed = 0;",
							"    ",
							"    // Function to process positions for this team",
							"    function processPosition(positionIndex) {",
							"        if (positionIndex >= positions.length) {",
							"            // Team complete",
							"            console.log('   Team ' + teamNum + ' complete: ' + teamSuccessful + ' successful, ' + teamFailed + ' failed');",
							"            totalSuccessful += teamSuccessful;",
							"            totalFailed += teamFailed;",
							"            completedTeams++;",
							"            processTeam(teamNum + 1);",
							"            return;",
							"        }",
							"        ",
							"        const pos = positions[positionIndex];",
							"        processPlayerInPosition(pos, 1, positionIndex);",
							"    }",
							"    ",
							"    // Function to process individual players in a position",
							"    function processPlayerInPosition(pos, playerIndex, positionIndex) {",
							"        if (playerIndex > pos.count) {",
							"            // Position complete, move to next position",
							"            processPosition(positionIndex + 1);",
							"            return;",
							"        }",
							"        ",
							"        const personIdVar = pos.role + '_team' + teamNum + '_' + playerIndex + '_personId';",
							"        const personId = pm.collectionVariables.get(personIdVar);",
							"        ",
							"        if (!personId) {",
							"            console.log('   ⚠️  ' + pos.position + ' ' + playerIndex + ' person ID not found for team ' + teamNum);",
							"            teamFailed++;",
							"            processPlayerInPosition(pos, playerIndex + 1, positionIndex);",
							"            return;",
							"        }",
							"        ",
							"        // Step 1: Create FloorballPlayer",
							"        const createPlayerRequest = {",
							"            url: pm.collectionVariables.get('baseUrl') + '/FloorballPlayer',",
							"            method: 'POST',",
							"            header: {",
							"                'Content-Type': 'application/json'",
							"            },",
							"            body: {",
							"                mode: 'raw',",
							"                raw: JSON.stringify({",
							"                    personId: personId",
							"                })",
							"            }",
							"        };",
							"        ",
							"        pm.sendRequest(createPlayerRequest, function (err, createResponse) {",
							"            if (err || createResponse.code !== 200) {",
							"                console.log('   ❌ Failed to create player for ' + pos.position + ' ' + playerIndex + ' in team ' + teamNum);",
							"                if (err) console.log('      Error: ' + err);",
							"                else console.log('      Response: ' + createResponse.code + ' - ' + createResponse.text());",
							"                teamFailed++;",
							"                processPlayerInPosition(pos, playerIndex + 1, positionIndex);",
							"                return;",
							"            }",
							"            ",
							"            // Step 2: Add player to team with position",
							"            const createResponseData = createResponse.json();",
							"            const playerId = createResponseData.data.id;",
							"            const jerseyNumber = ((teamNum - 1) * playersPerTeam) + teamPlayersProcessed + 1;",
							"            ",
							"            const addToTeamRequest = {",
							"                url: pm.collectionVariables.get('baseUrl') + '/FloorballTeam/' + teamId + '/players/' + playerId + '?position=' + pos.position + '&jerseyNumber=' + jerseyNumber,",
							"                method: 'POST',",
							"                header: {",
							"                    'Content-Type': 'application/json'",
							"                }",
							"            };",
							"            ",
							"            pm.sendRequest(addToTeamRequest, function (err2, addResponse) {",
							"                teamPlayersProcessed++;",
							"                ",
							"                if (err2 || addResponse.code !== 200) {",
							"                    console.log('   ❌ Failed to add ' + pos.position + ' ' + playerIndex + ' to team ' + teamNum);",
							"                    if (err2) console.log('      Error: ' + err2);",
							"                    else console.log('      Response: ' + addResponse.code + ' - ' + addResponse.text());",
							"                    teamFailed++;",
							"                } else {",
							"                    console.log('   ✅ Added ' + pos.position + ' ' + playerIndex + ' to team ' + teamNum + ' (Jersey #' + jerseyNumber + ')');",
							"                    teamSuccessful++;",
							"                }",
							"                ",
							"                processPlayerInPosition(pos, playerIndex + 1, positionIndex);",
							"            });",
							"        });",
							"    }",
							"    ",
							"    // Start processing positions for this team",
							"    processPosition(0);",
							"}",
							"",
							"// Start the batch process",
							"console.log('Starting batch player creation and assignment...');",
							"processTeam(1);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			},
			"response": []
		}
	]
