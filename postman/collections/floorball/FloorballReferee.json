		},
		{
			"name": "Verify",
			"item": [
				{
					"name": "01 - Get All Referees",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/FloorballReferee",
							"host": ["{{baseUrl}}"],
							"path": ["FloorballReferee"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"console.log('🔍 Verifying created referees...');",
									"console.log('Response status:', pm.response.code);",
									"",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    ",
									"    if (response.success && response.data) {",
									"        const referees = response.data;",
									"        console.log(`✅ Found ${referees.length} referees in total`);",
									"        ",
									"        referees.forEach((referee, index) => {",
									"            console.log(`   ${index + 1}. ${referee.fullName || referee.name || 'ID: ' + referee.id}`);",
									"            console.log(`      - Referee ID: ${referee.id}`);",
									"            console.log(`      - Person ID: ${referee.personId}`);",
									"            console.log(`      - License expires: ${referee.licenseExpiryDate}`);",
									"        });",
									"    } else {",
									"        console.log('❌ No referees data found in response');",
									"    }",
									"} else {",
									"    console.log('❌ Failed to fetch referees, status:', pm.response.code);",
									"}"
