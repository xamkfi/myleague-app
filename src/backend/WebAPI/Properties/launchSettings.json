{
  "profiles": {
    "WebAPI": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "/scalar/v1",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "http://localhost:8080"
    },
    "Docker Compose": {
        "commandName": "DockerCompose",
        "launchBrowser": true,
        "launchUrl": "http://localhost:8080/scalar/v1",
        "environmentVariables": {
            "ASPNETCORE_ENVIRONMENT": "Development"
        },
        "publishAllPorts": false,
        "useSSL": false,
        "composeLaunchServiceName": "webapi",
        "DockerComposeAction": "UpBuild"
    }
  }
}
