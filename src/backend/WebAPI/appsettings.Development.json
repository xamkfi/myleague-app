{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Information",
                "Microsoft.EntityFrameworkCore": "Information"
            }
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Database=myleague;Username=postgres;Password=postgres;Port=5432"
    },
    "HealthChecks": {
        "UI": {
            "Endpoint": "http://localhost:8080/health"
        }
    },
  "Pagination": {
    "Global": {
      "DefaultPageSize": 5,
      "MaxPageSize": 50,
      "MinPageSize": 1
    },
    "Resources": {
      "News": {
        "DefaultPageSize": 5,
        "MaxPageSize": 25
      },
      "FloorballPlayers": {
        "DefaultPageSize": 10,
        "MaxPageSize": 50
      }
    }
  }
} 
