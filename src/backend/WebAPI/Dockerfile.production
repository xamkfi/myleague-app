# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copy csproj files first for better caching
COPY src/backend/WebAPI/WebAPI.csproj src/backend/WebAPI/
COPY src/backend/Application/Application.csproj src/backend/Application/
COPY src/backend/Domain/Domain.csproj src/backend/Domain/
COPY src/backend/Infrastructure/Infrastructure.csproj src/backend/Infrastructure/

RUN dotnet restore "src/backend/WebAPI/WebAPI.csproj"

# Copy rest of backend
COPY src/backend/ ./src/backend/

WORKDIR /src/src/backend/WebAPI
RUN dotnet build "WebAPI.csproj" -c $BUILD_CONFIGURATION -o /app/build

# Publish stage
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
WORKDIR /src/src/backend/WebAPI
RUN dotnet publish "WebAPI.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# Final stage
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "WebAPI.dll"]
